# iPerson Backend - FastAPI application configuration

# Database
DATABASE_URL=postgresql+asyncpg://iperson:iperson@localhost:5432/iperson
DATABASE_URL_SYNC=postgresql://iperson:iperson@localhost:5432/iperson

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=iperson-media

# Platform API Keys (placeholders)
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=